datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  spotifyId     String?   @unique
  displayName   String?
  avatarUrl     String?
  country       String?

  // Sync state
  lastSyncAt    DateTime?
  syncStatus    String    @default("PENDING") // PENDING, SYNCING, COMPLETE, FAILED

  // Processed globe data (JSON strings for SQLite compatibility)
  globeData     String?   // UserGlobeNode[]
  homeRegion    String?   // HomeRegion
  tasteSummary  String?

  // Phase 2 additions:
  frontierData       String?    // serialized ArtistNode[]
  perimeterData      String?    // serialized PerimeterData[]
  frontierStatus     String     @default("PENDING") // PENDING, COMPUTING, COMPLETE, FAILED
  frontierComputedAt DateTime?
  adventurousnessHistory String? // serialized AdventurnousnessMetric[]
  exploredArtists    ExploredArtist[]

  // Auth relations
  accounts      Account[]
  sessions      Session[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([spotifyId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExploredArtist {
  id             String   @id @default(cuid())
  userId         String
  artistId       String   // Spotify artist ID
  source         String   // 'add-to-spotify' | 'mark-explored' | 'spotify-sync'
  exploredAt     DateTime @default(now())
  lastExploredAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [spotifyId])

  @@unique([userId, artistId])
  @@index([userId])
}

