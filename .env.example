# Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=  # REQUIRED: generate with `openssl rand -base64 32`
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Required for Last.fm lookups. Never commit a real key to the repo.
LASTFM_API_KEY=

# MusicBrainz API keys (optional, up to 4 for higher throughput).
# Without any keys, the app runs at 1 rps (anonymous).
# Each key gives an additional 1 rps bucket (round-robin).
# Register at https://musicbrainz.org/account/applications
MUSICBRAINZ_API_KEY_1=  # optional
MUSICBRAINZ_API_KEY_2=  # optional
MUSICBRAINZ_API_KEY_3=  # optional
MUSICBRAINZ_API_KEY_4=  # optional

# Admin endpoints (Bearer token or x-admin-key header)
ADMIN_SECRET=  # REQUIRED for /api/admin/* endpoints

# Gemini API for LLM-powered taste expansion explanations
GEMINI_API_KEY=  # Optional — app degrades gracefully to deterministic without it

# Demo mode: unauthenticated ?demo=true routes and demo-related branches
# resolve ONLY the demo-user row and ONLY when this is 1.
# Keep 0 in production. Set 1 for local development only.
ENABLE_DEMO=0

# Database — required by prisma/schema.prisma (provider = postgresql)
# Local Postgres (Homebrew): brew install postgresql@16 && brew services start postgresql@16
#   then: createdb orca
# Docker alternative: docker compose up -d
DATABASE_URL="postgresql://jeet@localhost:5432/orca"
# Remote (Vercel/Neon/Supabase):
# DATABASE_URL="postgresql://user:pass@host:5432/orca?sslmode=require"
# SQLite fallback (only if you temporarily switch provider back to "sqlite"):
# DATABASE_URL="file:./prisma/dev.db"

# Part 14 — Tier 1 embedding sidecar (CLAP)
# `npm run dev` / `npm start` auto-start the sidecar and set these if unset.
ORCA_EMBEDDING_URL=http://127.0.0.1:8080
ORCA_EMBEDDING_MODEL_ID=clap-http-v1
# ORCA_EMBED_MODE=stub   # default in scripts (fast). Use clap for real weights.
# ORCA_EMBED_PORT=8080
# ORCA_EMBEDDING_ALLOW_MOCK=1   # tests only — never production

# Part 15 — set to 0 only to reproduce pre-fix GRE non-persist bug
# GRE_PERSIST_ON_MATERIALIZE=1